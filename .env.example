# Copie para .env e preencha. NUNCA commite o .env.

# Provedor de LLM: mock | anthropic | openai | gemini
# "mock" usa respostas gravadas em backend/demo_data/ (sem custo, sem chave)
LLM_PROVIDER=mock

# Modelos (usados apenas quando LLM_PROVIDER != mock)
LLM_MODEL_PERSONAS=
LLM_MODEL_ANALISTA=

# Chaves de API (preencha apenas a do provedor escolhido)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Banco de dados
DATABASE_URL=sqlite:///./marketmind.db

# Origem do frontend liberada no CORS
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
