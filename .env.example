# Modelo de configuração. Copie para .env e preencha.
# O .env está no .gitignore — NUNCA commite chaves.

# Provedor de LLM: mock | groq | gemini | ollama
#   mock   -> respostas gravadas em backend/demo_data/ (sem chave, sem custo)
#   groq   -> chave grátis em https://console.groq.com/keys
#   gemini -> chave grátis em https://aistudio.google.com/apikey
#   ollama -> modelo rodando no seu PC (https://ollama.com), sem chave
LLM_PROVIDER=mock

# Nome do modelo — copie do painel do provedor escolhido:
#   Groq:   https://console.groq.com/docs/models
#   Gemini: https://ai.google.dev/gemini-api/docs/models
#   Ollama: o nome usado em `ollama pull <modelo>`
LLM_MODEL_PERSONAS=
LLM_MODEL_ANALISTA=

# Reserva: usada automaticamente se o provedor principal falhar
# (limite estourado, servidor fora do ar, resposta inválida). Deixe vazio para não usar.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL_PERSONAS=
LLM_FALLBACK_MODEL_ANALISTA=
# Se a reserva também falhar, usa as respostas gravadas (demo_data) em vez de dar erro
LLM_MOCK_NO_FIM=true

# Chaves de API (preencha apenas as que for usar)
GROQ_API_KEY=
GEMINI_API_KEY=

# Ollama (só se usar LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Banco de dados
DATABASE_URL=sqlite:///./marketmind.db

# Origem do frontend liberada no CORS
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
